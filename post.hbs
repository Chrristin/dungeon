{{!< default}}

{{#post}}
<div class="post-stage">
    <article class="post-panel {{post_class}}" data-key="{{slug}}">
        <header class="panel-head">
            <div class="panel-meta">
                <span class="code" data-tag="{{#primary_tag}}{{slug}}{{/primary_tag}}" data-date="{{date format="YYMMDD"}}">#{{date format="YYMMDD"}}</span>
                <span class="card-line" aria-hidden="true"></span>
                {{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}
            </div>
            <h1 class="panel-title">{{title}}</h1>
            <p class="panel-sub"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>, {{reading_time minute="1 min read" minutes="% min read"}}</p>
            {{#if custom_excerpt}}<p class="panel-lede">{{custom_excerpt}}</p>{{/if}}
        </header>

        {{#if feature_image}}
        <figure class="panel-image">
            <img
                srcset="{{img_url feature_image size="s"}} 600w,
                        {{img_url feature_image size="m"}} 1200w"
                sizes="(max-width: 800px) 92vw, 760px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
        {{/if}}

        <div class="panel-content gh-content">
            {{content}}
        </div>

        {{#if tags}}
        <ul class="chips panel-tags">
            {{#foreach tags}}<li><a href="{{url}}">{{name}}</a></li>{{/foreach}}
        </ul>
        {{/if}}

        <div class="post-actions" data-slug="{{slug}}" data-url="{{url absolute="true"}}" data-title="{{title}}">
            {{#if @custom.stamps_endpoint}}
            <div class="stamp" data-endpoint="{{@custom.stamps_endpoint}}" data-slug="{{slug}}" data-bad-name="{{t "Name not allowed"}}" hidden>
                <button class="stamp-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="{{t "Stamp: I was here"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3.5h6l-.8 7h-4.4z"/><path d="M5 13.5h14v3H5z"/><path d="M4 20.5h16"/><path d="M10 10.5v3M14 10.5v3"/></svg><span class="stamp-count"></span></button>
                <div class="stamp-mark" hidden><span class="stamp-seen">{{t "Seen"}}</span><span class="stamp-date"></span><span class="stamp-name"><input type="text" maxlength="24" autocomplete="off" aria-label="{{t "Leave your name"}}"><span class="stamp-prompt" aria-hidden="true">{{t "leave name"}}</span><span class="stamp-signed"></span></span></div>
                <div class="stamp-list" hidden><div class="stamp-list-rows"></div><p class="stamp-more" data-word="{{t "more"}}"></p></div>
            </div>
            {{/if}}
            <div class="post-share">
                <button class="post-share-button" type="button" aria-expanded="false" aria-haspopup="true" aria-label="{{t "Share"}}" title="{{t "Share"}}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8M5 12.5v6.5a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5v-6.5"/></svg>
                </button>
                <div class="post-share-menu" hidden>
                    <button type="button" data-share="copy" data-copied="{{t "Link copied"}}">{{t "Copy link"}}</button>
                    <a data-share="x" target="_blank" rel="noopener">X</a>
                    <a data-share="linkedin" target="_blank" rel="noopener">LinkedIn</a>
                    <a data-share="whatsapp" target="_blank" rel="noopener">WhatsApp</a>
                    <a data-share="email">{{t "Email"}}</a>
                </div>
            </div>
        </div>
    </article>

    {{#if comments}}
    <div class="post-comments">{{comments}}</div>
    {{/if}}

    <nav class="post-next" aria-label="{{t "More posts"}}">
        {{!-- Neighbouring posts, skipping Now months (#now) and Scatter notes (#note), which have no page of their own. Ghost's prev_post/next_post would link to them. --}}
        {{#get "posts" filter="published_at:<'{{published_at}}'+tag:-hash-now+tag:-hash-note+id:-{{id}}" order="published_at desc" limit="1"}}{{#foreach posts}}<a class="post-next-link" href="{{url}}"><span class="post-next-label">{{t "Older"}}</span><span class="post-next-title">{{title}}</span></a>{{/foreach}}{{/get}}
        {{#get "posts" filter="published_at:>'{{published_at}}'+tag:-hash-now+tag:-hash-note+id:-{{id}}" order="published_at asc" limit="1"}}{{#foreach posts}}<a class="post-next-link post-next-link--newer" href="{{url}}"><span class="post-next-label">{{t "Newer"}}</span><span class="post-next-title">{{title}}</span></a>{{/foreach}}{{/get}}
    </nav>
</div>
{{/post}}
