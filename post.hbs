{{!< default}}

{{#post}}
<div class="post-stage">
    <article class="post-panel {{post_class}}" data-key="{{slug}}">
        {{!-- Card order: the image comes first, then the code line, title and excerpt, as on the card, so a card can
              open into its post without anything changing place. The internal tag #hide-image keeps the feature
              image off the post itself; it still shows on cards and in social previews --}}
        {{#if feature_image}}{{^has tag="#hide-image"}}
        <figure class="panel-image">
            <img
                srcset="{{img_url feature_image size="s"}} 600w,
                        {{img_url feature_image size="m"}} 1200w"
                sizes="(max-width: 800px) 92vw, 760px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
        {{/has}}{{/if}}
        <header class="panel-head">
            <div class="panel-meta">
                <span class="code" data-tag="{{#primary_tag}}{{slug}}{{/primary_tag}}" data-date="{{date format="YYMMDD"}}">#{{date format="YYMMDD"}}</span>
                <span class="card-line" aria-hidden="true"></span>
                {{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}
            </div>
            {{> "rating-stamp"}}
            <h1 class="panel-title">{{title}}</h1>
            <p class="panel-sub"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>, {{reading_time minute="1 min read" minutes="% min read"}}</p>
            {{#if custom_excerpt}}<p class="panel-lede">{{custom_excerpt}}</p>{{/if}}
        </header>


        <div class="panel-content gh-content">
            {{content}}
        </div>

        {{#if tags}}
        <ul class="chips panel-tags">
            {{#foreach tags}}<li><a href="{{url}}">{{name}}</a></li>{{/foreach}}
        </ul>
        {{/if}}

        <div class="post-actions" data-slug="{{slug}}" data-url="{{url absolute="true"}}" data-title="{{title}}">
            {{#if @custom.stamps_endpoint}}
            <div class="stamp" data-endpoint="{{@custom.stamps_endpoint}}" data-slug="{{slug}}" data-bad-name="{{t "Name not allowed"}}" data-marked="{{t "You left your mark already"}}" hidden>
                <button class="stamp-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="{{t "Stamp: I was here"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3.5h6l-.8 7h-4.4z"/><path d="M5 13.5h14v3H5z"/><path d="M4 20.5h16"/><path d="M10 10.5v3M14 10.5v3"/></svg><span class="stamp-count"></span></button>
                <div class="stamp-mark" hidden><span class="stamp-seen">{{t "Seen"}}</span><span class="stamp-date"></span><span class="stamp-name"><span class="stamp-field"><input type="text" maxlength="24" autocomplete="off" aria-label="{{t "Leave your name"}}"><span class="stamp-prompt" aria-hidden="true">{{t "leave name"}}</span></span><span class="stamp-signed"></span><button class="stamp-unsign" type="button" aria-label="{{t "Remove my name"}}" hidden>&times;</button></span></div>
                <div class="stamp-list" hidden data-remove="{{t "Remove my name"}}"><div class="stamp-list-rows"></div><p class="stamp-more" data-word="{{t "more"}}"></p></div>
            </div>
            {{/if}}
            <div class="post-share">
                <button class="post-share-button" type="button" aria-expanded="false" aria-haspopup="true" aria-label="{{t "Share"}}" title="{{t "Share"}}">
                    <svg class="share-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8M5 12.5v6.5a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5v-6.5"/></svg>
                    <svg class="share-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2c.55 0 1 .35 1.2.85l5.35 14.3c.35.95-.65 1.8-1.5 1.3l-4.2-2.5a1.65 1.65 0 0 0-1.7 0l-4.2 2.5c-.85.5-1.85-.35-1.5-1.3L10.8 4.05c.2-.5.65-.85 1.2-.85z"/><path d="M12 16.6V9.2"/></svg>
                </button>
                <div class="post-share-menu" hidden>
                    <button type="button" data-share="copy" data-copied="{{t "Link copied"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 13.4a3.6 3.6 0 0 0 5.1 0l2.9-2.9a3.6 3.6 0 0 0-5.1-5.1l-1.1 1.1"/><path d="M13.4 10.6a3.6 3.6 0 0 0-5.1 0l-2.9 2.9a3.6 3.6 0 0 0 5.1 5.1l1.1-1.1"/></svg><span>{{t "Copy Link"}}</span></button>
                    <a data-share="twitter" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.8h12a2.7 2.7 0 0 1 2.7 2.7v6.6a2.7 2.7 0 0 1-2.7 2.7h-6.3l-3.9 3c-.55.42-1.35.03-1.35-.66V16.8H6a2.7 2.7 0 0 1-2.7-2.7V7.5A2.7 2.7 0 0 1 6 4.8z"/><path d="M8 9.3h8M8 12.3h5"/></svg><span>Twitter</span></a>
                    <a data-share="linkedin" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="7.4" width="17.6" height="12.4" rx="2.6"/><path d="M9 7.4V6a1.6 1.6 0 0 1 1.6-1.6h2.8A1.6 1.6 0 0 1 15 6v1.4"/><path d="M3.4 12.6c5.6 2.2 11.6 2.2 17.2 0"/></svg><span>LinkedIn</span></a>
                    <a data-share="whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.6a8.4 8.4 0 1 1-4.1 15.75L4.4 20.4c-.4.12-.76-.25-.64-.64l1.05-3.45A8.4 8.4 0 0 1 12 3.6z"/><path d="M8.9 12h.01M12 12h.01M15.1 12h.01" stroke-width="2.4"/></svg><span>WhatsApp</span></a>
                    <a data-share="email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.6"/><path d="m4.4 7.6 6.6 4.9a1.7 1.7 0 0 0 2 0l6.6-4.9"/></svg><span>{{t "Email"}}</span></a>
                </div>
            </div>
        </div>
        {{!-- Readers can rate what you've rated: out of 5 in halves, through the stamps Worker, with the stickies' spam check --}}
        {{#has tag="#rated-0-5, #rated-1, #rated-1-5, #rated-2, #rated-2-5, #rated-3, #rated-3-5, #rated-4, #rated-4-5, #rated-5"}}{{#if @custom.stamps_endpoint}}{{#if @custom.stickies_site_key}}
        <section class="rate" data-endpoint="{{@custom.stamps_endpoint}}" data-slug="{{slug}}" data-sitekey="{{@custom.stickies_site_key}}"{{#if @member}} data-member="1"{{/if}} aria-labelledby="rate-title-{{id}}"
            data-none="{{t "No reader ratings yet"}}" data-few="{{t "so far"}}" data-one="{{t "reader rating"}}" data-many="{{t "reader ratings"}}" data-readers="{{t "Readers"}}" data-from="{{t "from"}}"
            data-hint="{{t "Tap a star; its left half gives a half star"}}" data-checking="{{t "Checking you're a person..."}}" data-thanks="{{t "Thanks!"}}" data-yours="{{t "Your rating"}}"
            data-err-spam="{{t "The spam check didn't pass. Please try again."}}" data-err-slow="{{t "That's a lot of ratings at once. Try again in a minute."}}" data-err-other="{{t "Couldn't save that right now. Please try again."}}" hidden>
            <div class="rate-head"><h2 class="rate-title" id="rate-title-{{id}}">{{t "Seen it? Rate it too"}}</h2><p class="rate-readers" aria-live="polite"></p></div>
            <div class="rate-row">
                <div class="rate-stars" role="slider" tabindex="0" aria-labelledby="rate-title-{{id}}" aria-valuemin="0.5" aria-valuemax="5" aria-valuenow="0" aria-valuetext="{{t "Not rated"}}"><span class="rate-fill" aria-hidden="true"></span></div>
                <p class="rate-msg" aria-live="polite"></p>
            </div>
            <div class="rate-turnstile"></div>
        </section>
        {{/if}}{{/if}}{{/has}}
    </article>

    {{!-- Stickies replace Ghost's comments when the stamps Worker and a Turnstile site key are set --}}
    {{#if @custom.stickies_site_key}}{{#if @custom.stamps_endpoint}}
    <section class="stickies" data-endpoint="{{@custom.stamps_endpoint}}" data-slug="{{slug}}" data-sitekey="{{@custom.stickies_site_key}}" data-topics="{{#foreach tags}}{{slug}} {{/foreach}}"
        data-waiting="{{t "waiting to be pinned"}}" data-remove="{{t "Take back my sticky"}}" data-send-back="{{t "Select to read it"}}"
        data-err-spam="{{t "The spam check didn't pass. Please try again."}}" data-err-name="{{t "That name isn't allowed. Try another, or leave it empty."}}"
        data-err-slow="{{t "That's a lot of stickies at once. Try again in a minute."}}" data-err-other="{{t "Couldn't pin that right now. Please try again."}}"
        data-checking="{{t "One moment, checking you're not a bot..."}}" data-anonymous="{{t "anonymous"}}" data-err-empty="{{t "Write something first."}}" data-member="{{#if @member}}1{{/if}}" data-member-name="{{@member.name}}" data-a-member="{{t "a member"}}" data-member-label="{{t "member"}}" data-author-label="{{t "Author"}}" aria-labelledby="stickies-title-{{id}}" hidden>
        <h2 class="visually-hidden" id="stickies-title-{{id}}">{{t "Stickies"}}</h2>
        {{!-- The writing sticky: always open, stuck on the post card's corner (below it on phones). The x crumples it and throws it away. --}}
        <form class="stickies-compose" novalidate>
            <button class="stickies-throw" type="button" aria-label="{{t "Throw it away"}}" title="{{t "Throw it away"}}">&times;</button>
            <label class="visually-hidden" for="sticky-text-{{id}}">{{t "Your sticky"}}</label>
            <textarea id="sticky-text-{{id}}" maxlength="200" rows="4" placeholder="{{t "Write something short..."}}" required></textarea>
            <div class="stickies-compose-row">
                {{#if @member}}
                {{!-- Signed in: the name comes from their Ghost account --}}
                <span class="stickies-as">{{t "as"}} {{#if @member.name}}{{@member.name}}{{else}}{{t "a member"}}{{/if}}</span>
                <input type="hidden" value="">
                {{else}}
                <label class="visually-hidden" for="sticky-name-{{id}}">{{t "Your name (optional)"}}</label>
                <input id="sticky-name-{{id}}" type="text" maxlength="24" autocomplete="nickname" placeholder="{{t "Your name (optional)"}}">
                {{/if}}
                <span class="stickies-left" aria-live="polite">200</span>
            </div>
            <div class="stickies-turnstile"></div>
            <div class="stickies-compose-actions">
                <span class="stickies-note">{{#if @member}}{{t "Pinned straight away."}}{{else}}{{t "Stickies appear once approved."}}{{/if}}</span>
                <button class="stickies-pin" type="submit" aria-label="{{t "Pin it"}}" title="{{t "Pin it"}}"><svg viewBox="0 0 32 32" aria-hidden="true"><g transform="rotate(35 16 16)"><path class="pin-head" d="M11 5.5h10a1.5 1.5 0 0 1 0 3h-1.2l1.4 7.2c2.6 1 4.3 2.9 4.3 4.8H6.5c0-1.9 1.7-3.8 4.3-4.8l1.4-7.2H11a1.5 1.5 0 0 1 0-3z"/><path class="pin-shine" d="M13.2 9.3l-1 6.1"/><path class="pin-needle" d="M16 20.6v8.4"/></g></svg></button>
            </div>
            <p class="stickies-msg" aria-live="polite"></p>
            {{#if @site.members_enabled}}{{#unless @member}}<a class="stickies-signin" href="#/portal/signin" data-portal="signin">{{t "Sign in to skip the wait"}}</a>{{/unless}}{{/if}}
        </form>
        <div class="stickies-head">
            <button class="stickies-toggle" type="button" aria-pressed="false" aria-label="{{t "Read as a list"}}" title="{{t "Read as a list"}}" data-list="{{t "Read as a list"}}" data-pile="{{t "Back to the pile"}}">
                <svg class="icon-list" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="5" height="5" rx="1.2" transform="rotate(-6 6 6.5)"/><path d="M11.5 6.5h9"/><rect x="3.5" y="9.5" width="5" height="5" rx="1.2" transform="rotate(5 6 12)"/><path d="M11.5 12h9"/><rect x="3.5" y="15" width="5" height="5" rx="1.2" transform="rotate(-4 6 17.5)"/><path d="M11.5 17.5h6.5"/></svg>
                <svg class="icon-pile" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7.5" width="10.5" height="10.5" rx="1.6" transform="rotate(-12 8.25 12.75)"/><rect x="10" y="4" width="10.5" height="10.5" rx="1.6" transform="rotate(9 15.25 9.25)"/><rect class="front" x="6.8" y="10" width="10.5" height="10.5" rx="1.6" transform="rotate(-3 12 15.25)"/></svg>
            </button>
        </div>
        {{!-- Two areas: the stage is where stickies can move (out and back under the pile); the board is where they sit --}}
        <div class="stickies-stage"><div class="stickies-board" role="list" aria-label="{{t "Stickies"}}"></div></div>
        <div class="stickies-list" role="list" hidden></div>
    </section>
    {{/if}}{{else}}
    {{#if comments}}
    <div class="post-comments">{{comments}}</div>
    {{/if}}
    {{/if}}

    {{#has tag="#garden"}}
    {{!-- A garden note: what links here (filled in from the note's garden data), and the way back to the garden --}}
    <nav class="garden-after" aria-label="{{t "In the garden"}}" data-mentioned="{{t "Mentioned in"}}" data-none="{{t "Nothing links here yet."}}" data-labels='{"log":"{{t "Tending log"}}","related":"{{t "Related"}}","map":"{{t "Nearby in the garden"}}","planted":"{{t "planted"}}","tended":"{{t "tended"}}","stage":"{{t "Stage"}}","confidence":"{{t "Confidence"}}","links":"{{t "Links"}}","plantedH":"{{t "Planted"}}","tendedH":"{{t "Tended"}}","length":"{{t "Length"}}","words":"{{t "words"}}","min":"{{t "min"}}","in":"{{t "in"}}","out":"{{t "out"}}","times":"{{t "times"}}","time":"{{t "time"}}","source":"{{t "Source"}}","thisNote":"{{t "this note"}}","keys":"{{t "shortcuts"}}"}'>
        <div class="garden-backlinks"></div>
        <a class="garden-back" href="{{@site.url}}/garden/">&larr; {{t "Back to the garden"}}</a>
    </nav>
    {{else}}
    {{!-- A post in the garden: what links to it, what it links to, and related notes and posts (from the Garden page's data) --}}
    <section class="post-garden" hidden data-labels='{"title":"{{t "In the garden"}}","mentioned":"{{t "Mentioned in"}}","links":"{{t "Links to"}}","related":"{{t "Related"}}"}' data-garden="{{@site.url}}/garden/"></section>
    <nav class="post-next" aria-label="{{t "More posts"}}">
        {{!-- Neighbouring posts, skipping Now months (#now) and Scatter notes (#note), which have no page of their own. Shown as horizontal cards: image (or a patterned block) on the left, title and excerpt on the right. --}}
        {{#get "posts" filter="published_at:<'{{published_at}}'+tag:-hash-now+tag:-hash-note+tag:-hash-garden+id:-{{id}}" order="published_at desc" limit="1" include="tags"}}{{#foreach posts}}<div class="post-next-item"><span class="post-next-label">{{t "Older"}}</span><article class="card card--row" data-key="{{slug}}"><div class="card-row-media" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="" loading="lazy">{{else}}<div class="card-fill" data-key="{{slug}}"></div>{{/if}}</div><div class="card-row-body"><header class="card-head"><time class="code" datetime="{{date format="YYYY-MM-DD"}}" data-tag="{{#primary_tag}}{{slug}}{{/primary_tag}}" data-date="{{date format="YYMMDD"}}">#{{date format="YYMMDD"}}</time><span class="card-line" aria-hidden="true"></span>{{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}</header><h2 class="card-title"><a href="{{url}}">{{title}}</a></h2><p class="card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="22"}}{{/if}}</p></div></article></div>{{/foreach}}{{/get}}
        {{#get "posts" filter="published_at:>'{{published_at}}'+tag:-hash-now+tag:-hash-note+tag:-hash-garden+id:-{{id}}" order="published_at asc" limit="1" include="tags"}}{{#foreach posts}}<div class="post-next-item post-next-item--newer"><span class="post-next-label">{{t "Newer"}}</span><article class="card card--row" data-key="{{slug}}"><div class="card-row-media" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="" loading="lazy">{{else}}<div class="card-fill" data-key="{{slug}}"></div>{{/if}}</div><div class="card-row-body"><header class="card-head"><time class="code" datetime="{{date format="YYYY-MM-DD"}}" data-tag="{{#primary_tag}}{{slug}}{{/primary_tag}}" data-date="{{date format="YYMMDD"}}">#{{date format="YYMMDD"}}</time><span class="card-line" aria-hidden="true"></span>{{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}</header><h2 class="card-title"><a href="{{url}}">{{title}}</a></h2><p class="card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="22"}}{{/if}}</p></div></article></div>{{/foreach}}{{/get}}
    </nav>
    {{/has}}
</div>
{{/post}}
