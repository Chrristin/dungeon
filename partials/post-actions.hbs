{{!-- The stamp ("I was here") and the share button, at the foot of a story or a watchlist item's page. Context: the post. --}}
<div class="post-actions" data-slug="{{slug}}" data-url="{{url absolute="true"}}" data-title="{{title}}">
    {{#if @custom.stamps_endpoint}}
    <div class="stamp" data-endpoint="{{@custom.stamps_endpoint}}" data-slug="{{slug}}" data-bad-name="{{t "Name not allowed"}}" data-marked="{{t "You left your mark already"}}" hidden>
        <button class="stamp-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="{{t "Stamp: I was here"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3.5h6l-.8 7h-4.4z"/><path d="M5 13.5h14v3H5z"/><path d="M4 20.5h16"/><path d="M10 10.5v3M14 10.5v3"/></svg><span class="stamp-count"></span></button>
        <div class="stamp-mark" hidden><span class="stamp-seen">{{t "Seen"}}</span><span class="stamp-date"></span><span class="stamp-name"><span class="stamp-field"><input type="text" maxlength="24" autocomplete="off" aria-label="{{t "Leave your name"}}"><span class="stamp-prompt" aria-hidden="true">{{t "leave name"}}</span></span><span class="stamp-signed"></span><button class="stamp-unsign" type="button" aria-label="{{t "Remove my name"}}" hidden>&times;</button></span></div>
        <div class="stamp-list" hidden data-remove="{{t "Remove my name"}}"><div class="stamp-list-rows"></div><p class="stamp-more" data-word="{{t "more"}}"></p></div>
    </div>
    {{/if}}
    <div class="post-share">
        <button class="post-share-button" type="button" aria-expanded="false" aria-haspopup="true" aria-label="{{t "Share"}}" title="{{t "Share"}}">
            <svg class="share-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8M5 12.5v6.5a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5v-6.5"/></svg>
            <svg class="share-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2c.55 0 1 .35 1.2.85l5.35 14.3c.35.95-.65 1.8-1.5 1.3l-4.2-2.5a1.65 1.65 0 0 0-1.7 0l-4.2 2.5c-.85.5-1.85-.35-1.5-1.3L10.8 4.05c.2-.5.65-.85 1.2-.85z"/><path d="M12 16.6V9.2"/></svg>
        </button>
        <div class="post-share-menu" hidden>
            <button type="button" data-share="copy" data-copied="{{t "Link copied"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 13.4a3.6 3.6 0 0 0 5.1 0l2.9-2.9a3.6 3.6 0 0 0-5.1-5.1l-1.1 1.1"/><path d="M13.4 10.6a3.6 3.6 0 0 0-5.1 0l-2.9 2.9a3.6 3.6 0 0 0 5.1 5.1l1.1-1.1"/></svg><span>{{t "Copy Link"}}</span></button>
            <a data-share="twitter" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.8h12a2.7 2.7 0 0 1 2.7 2.7v6.6a2.7 2.7 0 0 1-2.7 2.7h-6.3l-3.9 3c-.55.42-1.35.03-1.35-.66V16.8H6a2.7 2.7 0 0 1-2.7-2.7V7.5A2.7 2.7 0 0 1 6 4.8z"/><path d="M8 9.3h8M8 12.3h5"/></svg><span>Twitter</span></a>
            <a data-share="linkedin" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="7.4" width="17.6" height="12.4" rx="2.6"/><path d="M9 7.4V6a1.6 1.6 0 0 1 1.6-1.6h2.8A1.6 1.6 0 0 1 15 6v1.4"/><path d="M3.4 12.6c5.6 2.2 11.6 2.2 17.2 0"/></svg><span>LinkedIn</span></a>
            <a data-share="whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.6a8.4 8.4 0 1 1-4.1 15.75L4.4 20.4c-.4.12-.76-.25-.64-.64l1.05-3.45A8.4 8.4 0 0 1 12 3.6z"/><path d="M8.9 12h.01M12 12h.01M15.1 12h.01" stroke-width="2.4"/></svg><span>WhatsApp</span></a>
            <a data-share="email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.6"/><path d="m4.4 7.6 6.6 4.9a1.7 1.7 0 0 0 2 0l6.6-4.9"/></svg><span>{{t "Email"}}</span></a>
        </div>
    </div>
</div>
