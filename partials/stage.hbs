{{!-- A post's or note's growth stage, from its internal tag (#seedling, #growing or #budding, #evergreen), drawn with the Garden page's sprouts. Nothing when it has none. --}}
{{#has tag="#evergreen"}}<span class="stage" data-stage="evergreen"><svg class="garden-sprout" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.3v-4.2M11.9 2.8l5.2 7.1h-3.1l4.2 6.3H5.9l4.1-6.2H6.9z"/></svg><span class="visually-hidden">{{t "evergreen"}}</span></span>{{else has tag="#growing,#budding"}}<span class="stage" data-stage="growing"><svg class="garden-sprout" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.2V9.4M12 13.6c-3.6.1-5.8-2-5.7-4.9 3.4-.1 5.7 1.9 5.7 4.9zM12.1 10.6c-.1-3.1 2-5.2 5.6-5.3.1 3.3-2.1 5.3-5.6 5.3z"/></svg><span class="visually-hidden">{{t "growing"}}</span></span>{{else has tag="#seedling"}}<span class="stage" data-stage="seedling"><svg class="garden-sprout" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5c-3.2 0-5.3-1.5-5.3-3.6s2.3-3.5 5.3-3.5 5.2 1.4 5.2 3.4-2 3.7-5.2 3.7zM12.2 13.4c-.2-2.3.6-4.1 2.3-5.1"/></svg><span class="visually-hidden">{{t "seedling"}}</span></span>{{/has}}
