{{!-- A related essay under a post: the same horizontal card as the homepage rows, image (or a patterned block) on the left, title and excerpt on the right. Context: the related post. --}}
<div class="post-next-item"><span class="post-next-label">{{t "Related"}}</span><article class="card card--row" data-key="{{slug}}"><div class="card-row-media" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy">{{else}}<div class="card-fill" data-key="{{slug}}"></div>{{/if}}</div><div class="card-row-body"><header class="card-head"><time class="code" datetime="{{date format="YYYY-MM-DD"}}" data-tag="{{#primary_tag}}{{slug}}{{/primary_tag}}" data-date="{{date format="YYMMDD"}}">#{{date format="YYMMDD"}}</time><span class="card-line" aria-hidden="true"></span>{{#primary_tag}}<span class="card-tag">{{name}}</span>{{/primary_tag}}</header><h2 class="card-title"><a href="{{url}}">{{title}}</a></h2><p class="card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="22"}}{{/if}}</p></div></article></div>
