{{!-- Plots: a homepage of plots, one per dimension of the site. A tag's image, if it has one, is etched faintly behind its plot. Drawn from the page with the address /plots/:
      its title is the badge, its excerpt the statement, its text the introduction (a bulleted list of links becomes
      a row of buttons), and its public tags, in order, are the plots. A tag's name, description and posts fill its
      plot; a tag with no posts yet shows as unplanted. Context: that page. --}}
<section class="plots" data-labels='{"0":"{{t "unplanted"}}","prep":"{{t "preparing ground"}}","1":"{{t "sprouting"}}","2":"{{t "growing"}}","3":"{{t "growing"}}","4":"{{t "flourishing"}}","5":"{{t "lit"}}","pieces":"{{t "pieces"}}","plots":"{{t "plots"}}","page":"{{t "page"}}","pagesWord":"{{t "pages"}}"}'>
    <div class="plots-band">
        <a class="plots-badge" href="{{@site.url}}">{{title}}</a>
        <span class="plots-stats" aria-live="polite"></span>
    </div>

    <div class="plots-hero">
        <div class="plots-hero-text">
            <h1 class="statement-text">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{@site.description}}{{/if}}</h1>
            {{!-- Everything after the statement's first comma is drawn in green ("Digital Christin, in progress."), and a closing full stop becomes
                 three dots that fill in one by one and fade, over and over. Runs as the page is read, so nothing flashes; without scripts the
                 statement stays as written. --}}
            <script>(function(h){var t=h.textContent.replace(/\s+$/,''),i=t.indexOf(',');if(i<0||i===t.length-1)return;var a=t.slice(i+1),m=a.match(/(\.{1,3}|\u2026)$/),s=document.createElement('span');s.className='plots-accent';s.textContent=m?a.slice(0,-m[0].length):a;if(m){var d=document.createElement('span');d.className='plots-dots';d.setAttribute('aria-hidden','true');d.innerHTML='<i>.</i><i>.</i><i>.</i>';s.appendChild(d);var r=document.createElement('span');r.className='visually-hidden';r.textContent='.';s.appendChild(r);}h.textContent=t.slice(0,i+1);h.appendChild(s);})(document.currentScript.previousElementSibling);</script>
            {{#if html}}<div class="plots-intro gh-content">{{content}}</div>{{/if}}
        </div>
        <aside class="plots-legend" aria-label="{{t "How far each piece has grown"}}">
            <p class="plots-legend-h">{{t "Growth"}}</p>
            <p><span class="stage" data-stage="seedling"><svg class="garden-sprout" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5c-3.2 0-5.3-1.5-5.3-3.6s2.3-3.5 5.3-3.5 5.2 1.4 5.2 3.4-2 3.7-5.2 3.7zM12.2 13.4c-.2-2.3.6-4.1 2.3-5.1"/></svg></span>{{t "Seedling: a single thought"}}</p>
            <p><span class="stage" data-stage="growing"><svg class="garden-sprout" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.2V9.4M12 13.6c-3.6.1-5.8-2-5.7-4.9 3.4-.1 5.7 1.9 5.7 4.9zM12.1 10.6c-.1-3.1 2-5.2 5.6-5.3.1 3.3-2.1 5.3-5.6 5.3z"/></svg></span>{{t "Growing: linked, still changing"}}</p>
            <p><span class="stage" data-stage="evergreen"><svg class="garden-sprout" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.3v-4.2M11.9 2.8l5.2 7.1h-3.1l4.2 6.3H5.9l4.1-6.2H6.9z"/></svg></span>{{t "Evergreen: settled enough to defend"}}</p>
        </aside>
    </div>

    <div class="plots-grid">
    {{#foreach tags visibility="public"}}
        <article class="card plot" data-key="plot-{{slug}}"{{#if accent_color}} style="--card: {{accent_color}}; --card-hi: {{accent_color}};"{{/if}} aria-labelledby="plot-{{slug}}">
            {{#if feature_image}}<img class="plot-etch" srcset="{{img_url feature_image size="s"}} 600w, {{img_url feature_image size="m"}} 1200w" sizes="(max-width: 900px) 200px, 600px" src="{{img_url feature_image size="s"}}" alt="" aria-hidden="true" loading="lazy" decoding="async">{{/if}}
            {{#get "posts" filter="tag:{{slug}}+tag:-hash-now" limit="5" include="tags" order="published_at desc" as |plotPosts plotPages|}}
            <header class="card-head plot-head">
                <span class="tag-code" data-tag="{{../slug}}"></span>
                <span class="card-line" aria-hidden="true"></span>
                <span class="plot-meter" data-count="{{plotPages.total}}" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                <span class="plot-status"></span>
            </header>
            <h2 class="plot-name" id="plot-{{../slug}}">{{../name}}</h2>
            {{#if ../description}}<p class="plot-desc">{{../description}}</p>{{/if}}
            {{#if plotPosts}}
            <ul class="plot-rows">
                {{#foreach plotPosts}}
                <li><a href="{{url}}">
                    <time class="code" datetime="{{date format="YYYY-MM-DD"}}" data-tag="{{#primary_tag}}{{slug}}{{/primary_tag}}" data-date="{{date format="YYMMDD"}}">#{{date format="YYMMDD"}}</time>
                    <span class="plot-row-title">{{title}}</span>
                    <span class="plot-row-kind">{{#has tag="#garden"}}{{t "note"}}{{else}}{{t "post"}}{{/has}}</span>
                    {{> "rating-stamp" size="small"}}
                    {{> "stage"}}
                </a></li>
                {{/foreach}}
            </ul>
            <footer class="card-foot plot-foot">
                <span class="card-line" aria-hidden="true"></span>
                <a class="plot-enter" href="{{../url}}">{{t "Enter"}} {{../name}}{{#if plotPages.next}} <span class="plot-more">({{plotPages.total}})</span>{{/if}}</a>
            </footer>
            {{else}}
            <p class="plot-empty">{{t "Not planted yet."}}</p>
            {{/if}}
            {{/get}}
            {{!-- Pages carrying this plot's tag are shown in the plot, under its description. A watchlist page (the Watchlist
                 template, the address /store/, or the internal tag #watchlist) gets a box with a live line from its shelf:
                 how many items, how many are a Must Buy, and when it was updated. A Library page (the Library template) gets a box
                 too: a small shelf of its books, or its feature image, with how many shelves and books. Two boxes share a row.
                 Any other page is a plain row. The Plots page
                 itself carries every plot's tag (that is how it names the plots), so it is left out. --}}
            {{#get "pages" filter="tag:{{slug}}+slug:-plots" limit="3" include="tags"}}{{#if pages}}
            <ul class="plot-pages">
                {{#foreach pages}}
                <li><a class="plot-page" href="{{url}}" data-template="{{custom_template}}" data-slug="{{slug}}"{{#has tag="#watchlist"}} data-watchlist="1"{{/has}} data-src="{{asset "data/store-lego.json"}}" data-library="{{asset "data/library.json"}}" data-image="{{#if feature_image}}{{img_url feature_image size="s"}}{{/if}}"><span class="plot-page-text"><span class="plot-page-kind">{{t "page"}}</span><span class="plot-page-title">{{title}}</span><span class="plot-page-line"></span></span><span class="plot-page-go" aria-hidden="true">→</span></a><template class="plot-page-body">{{content}}</template></li>
                {{/foreach}}
            </ul>
            {{/if}}{{/get}}
        </article>
    {{/foreach}}
    </div>

    <div class="plots-after">
        {{#get "posts" limit="5" order="published_at desc" filter="tag:-[hash-now,hash-thing,hash-watch-item]" include="tags"}}
        {{#if posts}}
        <section class="plots-tended" aria-labelledby="plots-tended-h">
            <h2 id="plots-tended-h" class="section-heading">{{t "Recently planted"}}</h2>
            <ul class="plots-tended-list">
                {{#foreach posts}}
                <li><a href="{{url}}">
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM"}}</time>
                    <span class="plots-tended-title">{{title}}</span>
                    {{> "stage"}}
                </a></li>
                {{/foreach}}
            </ul>
        </section>
        {{/if}}
        {{/get}}
        {{#get "pages" filter="slug:garden" limit="1"}}
        {{#foreach pages}}
        <a class="plots-garden" href="{{url}}">
            <span class="plots-garden-path">/garden</span>
            <span class="plots-garden-h">{{t "Wander the whole garden"}}</span>
            <span class="plots-garden-sub">{{t "Every note and post, how they link, and the map of it all"}}</span>
        </a>
        {{/foreach}}
        {{/get}}
    </div>
</section>
<script src="{{asset "js/store.js"}}&r=2.21.6" defer></script>
