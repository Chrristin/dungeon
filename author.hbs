{{!< default}}

{{#author}}
<section class="statement statement--small">
    <p class="statement-role">{{t "Writing here"}}</p>
    <h1 class="statement-text">{{name}}</h1>
    {{#if bio}}<p class="statement-desc">{{bio}}</p>{{/if}}
</section>
{{/author}}

<section class="log" aria-label="{{t "Posts"}}">
    <div class="cards">
    {{#foreach posts}}
        {{> "post-row"}}
    {{/foreach}}
    </div>
    {{pagination}}
</section>
