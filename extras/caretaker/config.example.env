# caretaker settings. This file lives at ~/.caretaker/config.env and is read as shell.

# --- the NAS ---
NAS_HOST=                       # its address on your network, e.g. 192.168.1.20 or nas.local
NAS_USER=                       # the NAS account the key belongs to
NAS_PORT=22
NAS_KEY="$HOME/.ssh/caretaker_ed25519"

# --- your phone (ntfy) ---
# A topic name is the only password, so these are long and random. Subscribe to NTFY_TOPIC in
# the ntfy app. NTFY_REPLY_TOPIC carries your Approve / Not now taps back; keep it to yourself.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=__TOPIC__
NTFY_REPLY_TOPIC=__REPLY__
NTFY_TOKEN=                     # only for a ntfy server with logins

# --- what to watch ---
URLS=""                         # addresses that must answer, separated by spaces
IGNORE=""                       # containers to leave alone, separated by spaces
DISK_WARN=90                    # tell me when a NAS volume is this full (percent)

# --- updates ---
# An image that does not say its version, on a tag like "latest", could be a major jump.
# ask: ask me first.  apply: apply it; a broken one is rolled back anyway.
UNKNOWN_VERSION=ask

# --- builds ---
REPOS=""                        # GitHub repositories to watch, e.g. "chrristin/dungeon"
BUILD_ALLOW=""                  # more commands the builds agent may run, e.g. "Bash(make *) Bash(cargo *)"

# --- the agents ---
MODEL=""                        # empty: Claude Code's default
MAX_BUDGET_USD=3                # most one agent run may spend (counts when Claude Code runs on an API key)
AGENT_MINUTES=30                # an agent still running after this long is stopped
DOCTOR_COOLDOWN_MIN=360         # the doctor looks at the same problem at most this often
