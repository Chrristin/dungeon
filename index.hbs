{{!< default}}

{{#is "home"}}
{{#unless pagination.prev}}
<section class="hero">
    <div class="hero-text">
        <h1 class="statement-text">{{@site.description}}</h1>
        {{#if @custom.role_line}}<p class="statement-role">{{@custom.role_line}}</p>{{/if}}
    </div>
    {{#if @custom.hero_card}}
    {{#get "posts" limit="1" include="tags,authors" filter="tag:-[hash-now,hash-note,hash-garden]"}}
        {{#foreach posts}}<div class="hero-card">{{> "post-row"}}</div>{{/foreach}}
    {{/get}}
    {{/if}}
</section>
{{/unless}}
{{/is}}

<section class="log" aria-labelledby="log-heading">
    {{#is "home"}}
        {{#if pagination.prev}}
            <h2 id="log-heading" class="section-heading">{{t "Older posts"}}</h2>
        {{else if @custom.list_heading}}
            <h2 id="log-heading" class="section-heading">{{@custom.list_heading}}</h2>
        {{else}}
            <h2 id="log-heading" class="visually-hidden">{{t "Posts"}}</h2>
        {{/if}}
    {{else}}
        <h2 id="log-heading" class="section-heading">{{t "Posts"}}</h2>
    {{/is}}
    <div class="cards">
    {{#is "home"}}
        {{#if pagination.prev}}
            {{#foreach posts}}{{> "post-row"}}{{/foreach}}
        {{else if @custom.hero_card}}
            {{!-- The newest post sits beside the statement on desktop; on phones and tablets it leads the list instead --}}
            {{#foreach posts}}{{#if @first}}<div class="list-first">{{> "post-row"}}</div>{{else}}{{> "post-row"}}{{/if}}{{/foreach}}
        {{else}}
            {{#foreach posts}}{{> "post-row"}}{{/foreach}}
        {{/if}}
    {{else}}
        {{#foreach posts}}{{> "post-row"}}{{/foreach}}
    {{/is}}
    </div>
    {{pagination}}
</section>
